# Copie para .env (cp .env.example .env) e preencha com os seus dados.
# O .env NUNCA deve ser commitado.

# Banco de desenvolvimento compartilhado (via Tailscale)
DB_HOST=100.94.96.41
DB_PORT=5432
DB_DATABASE=rotinaplusdev
DB_USERNAME=
DB_PASSWORD=

# Só o dono do banco deve usar "true" (aplica as migrations ao subir).
RUN_MIGRATIONS=false

# Opcional: deixe vazio para gerar uma chave automaticamente.
APP_KEY=

# Portas no seu computador (mude se 8000/5173 já estiverem em uso).
BACKEND_PORT=8000
FRONTEND_PORT=5173
